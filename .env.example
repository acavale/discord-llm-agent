# Per-machine secrets and paths. Copy this to `.env` (gitignored). Never commit `.env`.

# --- Secrets ---
DISCORD_TOKEN=your-discord-bot-token
XAI_API_KEY=your-hosted-model-key   # used for provider: grok and for image captioning

# --- Storage root ---
# The folder that holds config.yaml, scheduler.json, the message archive (guild_*.jsonl), knowledge/, etc.
# Use a separate folder (and a separate test bot token + test server) for development, so a dev
# instance never touches a live instance's data.
#   STORAGE_ROOT=/path/to/agent-data
# If left blank, the loader falls back to ./data.
STORAGE_ROOT=

# --- Local data dir ---
# Where the derived SQLite index lives. Keep it on local disk; do not put a live database in a
# synced folder. Defaults to ~/.discord_agent if unset.
# LOCAL_DATA_DIR=
